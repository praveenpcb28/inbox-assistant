# GEMINI_API_KEY: Required for Gemini AI API calls (triage, multi-language drafting, and ad-hoc inbox queries).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# (Optional) GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: For production server-side Google Workspace OAuth
# Required scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.compose
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# (Optional) MICROSOFT_CLIENT_ID & MICROSOFT_CLIENT_SECRET: For production Microsoft 365 / Graph OAuth
# Required delegated permissions: Mail.Read, Mail.ReadWrite
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
